# Copier dans .env.local, puis renseigner les accès d’envoi (jamais NEXT_PUBLIC_).
# Exemple Gmail : compte avec validation en deux étapes et mot de passe d’application.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vertlhorizon64@gmail.com
SMTP_PASSWORD=
# Facultatif : adresse d’expéditeur autorisée par le service SMTP.
SMTP_FROM=vertlhorizon64@gmail.com
# Uniquement pour un test de production sur disque persistant :
# ENABLE_LOCAL_QUOTE_STORAGE=true

# Production Render : domaine canonique et disque persistant monté dans /var/data.
# SITE_URL=https://vert-lhorizon.fr
# QUOTE_STORAGE_DIR=/var/data/quote-requests

# Netlify : défini automatiquement au build par netlify.toml.
# NEXT_PUBLIC_QUOTE_PROVIDER=netlify
# En local, laisser absent pour utiliser le test SMTP existant.
